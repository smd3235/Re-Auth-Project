_compile_test.xlsm
_dbg*.xlsm
_check*.py
_check*.py
_debug*.py
_dbg*.py
_inspect_report.py
_verify_tpl.py
_force_sync.py
_compile.py
probe_ran.txt
_tmp_gitignore.txt

# Python
__pycache__/
*.pyc
scripts/__pycache__/
